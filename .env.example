# ==============================================================================
# RailOpt AI - Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL / PostGIS)
POSTGRES_DB=railopt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=railopt_password_2026
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:railopt_password_2026@127.0.0.1:5432/railopt

# Keycloak OIDC Authentication Configuration
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=railopt
KEYCLOAK_CLIENT_ID=railopt-web
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
DEMO_USER_PASSWORD=railopt_demo_2026

# Backend FastAPI Configuration
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM Explainability Provider Architecture (Advisory Translation Layer)
LLM_PROVIDER=auto
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_SECONDS=25.0

# Gemini Hosted LLM Fallback (Backend Secret Only - Never Expose to Frontend)
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20.0
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Frontend Next.js Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=railopt
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=railopt-web