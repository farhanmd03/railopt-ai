# ==============================================================================
# RailOpt AI - Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL / PostGIS)
POSTGRES_DB=railopt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=railopt_password_2026
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:railopt_password_2026@127.0.0.1:5432/railopt

# Generic OIDC / Auth0 / Keycloak Authentication Configuration
# For Auth0:
# OIDC_ISSUER_URL=https://farhanmd03.us.auth0.com/
# OIDC_CLIENT_ID=your_auth0_client_id_here
# OIDC_AUDIENCE=https://railopt-ai-api
# OIDC_JWKS_URL=https://farhanmd03.us.auth0.com/.well-known/jwks.json
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Keycloak Local Fallback Configuration
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=railopt
KEYCLOAK_CLIENT_ID=railopt-web
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
DEMO_ACCESS_ENABLED=false
DEMO_USER_PASSWORD=

# Backend FastAPI Configuration
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM Explainability Provider Architecture (Advisory Translation Layer)
LLM_PROVIDER=auto
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_SECONDS=25.0

# Gemini Hosted LLM Fallback (Backend Secret Only - Never Expose to Frontend)
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20.0
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Frontend Next.js Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_OIDC_ISSUER_URL=https://farhanmd03.us.auth0.com/
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_AUDIENCE=https://railopt-ai-api
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=railopt
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=railopt-web
NEXT_PUBLIC_DEMO_ACCESS_ENABLED=false