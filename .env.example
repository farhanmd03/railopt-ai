# Application
APP_NAME=RailOpt AI
APP_ENV=development

# PostgreSQL
POSTGRES_DB=railopt
POSTGRES_USER=railopt
POSTGRES_PASSWORD=railopt_dev_password
DATABASE_URL=postgresql+psycopg://railopt:railopt_dev_password@localhost:5432/railopt

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=railopt
KEYCLOAK_CLIENT_ID=railopt-web

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b