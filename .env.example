# Application
APP_NAME=RailOpt AI
APP_ENV=development

# PostgreSQL
POSTGRES_DB=railopt
POSTGRES_USER=railopt
POSTGRES_PASSWORD=railopt_dev_password
DATABASE_URL=postgresql+psycopg://railopt:railopt_dev_password@localhost:5432/railopt

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=railopt
KEYCLOAK_CLIENT_ID=railopt-web
KC_ADMIN_PASSWORD=your_keycloak_admin_password_here

# Keycloak Local Demo Testing
# Set DEMO_USER_PASSWORD in .env for local development; use a non-default value for any shared/demo environment.
# DEMO_USER_PASSWORD=your_local_demo_user_password_here

# Next.js Frontend (services/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=railopt
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=railopt-web

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b